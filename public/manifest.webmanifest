{
  "name": "Fish Fillets 4ever",
  "short_name": "Fish Fillets",
  "description": "A faithful web port of ALTAR's 1998 underwater puzzle game Fish Fillets. Guide two fish through 70 rooms without letting anything crush them.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "landscape",
  "background_color": "#101018",
  "theme_color": "#101018",
  "lang": "en",
  "dir": "ltr",
  "categories": ["games", "puzzle", "entertainment"],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
