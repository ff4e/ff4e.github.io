<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Apple TV app's Info.plist (native/CMakeLists.txt, MACOSX_BUNDLE_INFO_PLIST). The $(…)
  are Xcode build settings, filled in when the app is built; the bundle id is the iOS app's,
  so the TV app is the same App Store app (a universal purchase). Xcode adds the icon and Top
  Shelf keys from the asset catalog (Assets.xcassets), and UIDeviceFamily and MinimumOSVersion.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>cs</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>cs</string>
		<string>en</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Fish Fillets</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.puzzle-games</string>
	<!-- A game for the remote alone: it SUPPORTS controllers (the Siri Remote is a micro
	     gamepad, an Xbox or PlayStation pad an extended one) and requires none. With
	     GCSupportsControllerUserInteraction the game, not the system, gets the remote's
	     input during play; native/host/main.c hands Menu back to the system at the map's
	     root (`systemBack`). -->
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>MicroGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<!-- The launch screen: black, as the game's first frame (the splash) is. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Required by App Store Connect (ITMS-90683, build 6) because SDL's HIDAPI links
	     CoreBluetooth to reach Steam Controllers over Bluetooth LE (src/hidapi/ios/hid.m).
	     SDL only starts Bluetooth when SDL_HINT_JOYSTICK_HIDAPI_STEAM is on; it is off by
	     default and the host never sets it, so no permission prompt is ever shown. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Fish Fillets uses Bluetooth only to connect game controllers.</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- The scene lifecycle (SDL supplies the scene delegate: SDLUIKitSceneDelegate). One
	     scene: a TV shows one app. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
