{
  "name": "fish-fillets-4ever",
  "version": "1.0.19",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "description": "Faithful web port of the 1998 ALTAR Fish Fillets engine, ported line-by-line from the original Delphi source.",
  "scripts": {
    "dump-ffr": "tsx tools/dump-ffr.ts",
    "render-room": "tsx tools/render-room.ts",
    "dev": "node tools/dev-server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "NO_COLOR=1 vitest run",
    "test:watch": "vitest",
    "test:solutions": "NO_COLOR=1 vitest run test/solutions.test.ts test/solutionsCoverage.test.ts",
    "test:seeds": "for s in $(seq 1 ${FF_SEEDS:-100}); do out=$(NO_COLOR=1 FF_TEST_SEED=$s vitest run --silent 2>&1) || { echo \"seed $s FAILED\"; echo \"$out\"; exit 1; }; done; echo \"${FF_SEEDS:-100} seeds passed\"",
    "test:ui": "node tools/run-ui-tests.mjs",
    "capture-digest": "node tools/capture-digest.mjs",
    "region-graph": "node tools/region-graph.mjs",
    "test:all": "npm run typecheck && npm run test && npm run test:ui",
    "test-move": "tsx tools/test-move.ts",
    "screenshot": "node tools/screenshot.mjs",
    "test-path": "tsx tools/test-path.ts",
    "dump-fft": "tsx tools/dump-fft.ts",
    "render-enhanced": "tsx tools/render-enhanced.ts",
    "stage-enhanced": "tsx tools/stage-enhanced.ts",
    "stage-enhanced-objects": "tsx tools/stage-enhanced-objects.ts",
    "stage-enhanced-fish": "tsx tools/stage-enhanced-fish.ts",
    "build-movies-ai": "node tools/build-movies-ai.mjs",
    "build-map-ai": "node tools/build-map-ai.mjs",
    "build-room-ai": "node tools/build-room-ai.mjs",
    "build-map-matrix": "node tools/build-map-matrix.mjs",
    "build-map-contest": "node tools/build-map-contest.mjs",
    "build-room-matrix": "node tools/build-room-matrix.mjs",
    "build-fish-outline": "node tools/build-fish-outline.mjs",
    "build-room-algo": "node tools/build-room-algo.mjs",
    "build-room-contest": "node tools/build-room-contest.mjs",
    "studio": "node tools/studio/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "playwright": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  }
}
