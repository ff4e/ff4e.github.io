<?xml version="1.0" encoding="utf-8"?>
<!--
  .NET Native runtime directives. The host app uses no reflection of its own, so the
  defaults are sufficient; the file must exist for the Release (.NET Native) build.
-->
<Directives xmlns="http://schemas.microsoft.com/netfx/2013/01/metadata">
  <Application>
    <Assembly Name="*Application*" Dynamic="Required All" />
  </Application>
</Directives>
