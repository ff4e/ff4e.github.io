<Page
    x:Class="Ff4eXbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="#101018">

    <Grid>
        <!-- The game fills the window; the page background matches the app's brand colour
             so the TV shows no white flash before the first frame is painted. -->
        <controls:WebView2 x:Name="WebView" />

        <TextBlock x:Name="ErrorText"
                   Visibility="Collapsed"
                   Foreground="#DDEEFF"
                   FontSize="28"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Margin="120" />
    </Grid>
</Page>
